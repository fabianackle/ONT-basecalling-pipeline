apptainer {
    enabled     = true
    pullTimeout = 1.h
    //cacheDir    = '/home/user/data/nf-apptainer/' // adjust caching directory
    autoMounts  = true
    runOptions  = '--nv'
}


process {
    cpus     = 8
    executor = 'slurm'
    shell    = ['/bin/bash', '-euo', 'pipefail']
    withLabel: dorado {
        container = 'nanoporetech/dorado:sha38b4ce849afa13eac8075f0b41cecd30799f169b' // dorado v2.0.0
    }
    withName: DORADO {
        clusterOptions = '--gpus=1 --constraint="GPUMEM80GB|GPUMEM96GB|GPUMEM140GB"' // either A100, H100, or H200
        memory         = 64.GB
        time           = { 30.m * (params.gigabases as Integer) }
    }
    withName: DEMUX {
        memory = 8.GB
        time   = 1.h
    }
}
